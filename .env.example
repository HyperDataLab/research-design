# Copy to .env.local (gitignored). These values are public identifiers of the Firebase web app, not secrets.
# Without them a production build shows "Chưa cấu hình đăng nhập"; the dev server falls back to the dev sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# The Worker (docs/WORKER_API.md). In dev, leave empty to use the in-process dev server at /api.
VITE_WORKER_URL=
