{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperdatalab-paragraph-lab.web.app/schemas/experiment-facts-v1.schema.json",
  "title": "PaperLab experiment facts, version 1",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "paperlab-experiment-facts" },
    "schemaVersion": { "type": "number", "const": 1 },
    "paperId": {
      "type": "string",
      "pattern": "^(sha256-[0-9a-f]{64}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "modelEtag": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "promptVersion": { "type": "string" },
        "model": { "type": "string" },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["id", "promptVersion", "model", "at"],
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "kind": {
                "type": "string",
                "enum": ["task", "design", "sample", "dataset", "baseline", "method", "metric", "result"]
              },
              "value": { "type": "string" },
              "number": { "type": ["number", "null"] },
              "unit": { "type": ["string", "null"] },
              "uncertainty": { "type": ["string", "null"] },
              "condition": { "type": ["string", "null"] },
              "metric": { "type": ["string", "null"] },
              "dataset": { "type": ["string", "null"] },
              "system": { "type": ["string", "null"] },
              "sentenceKeys": { "minItems": 1, "type": "array", "items": { "type": "string" } },
              "tableCell": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "blockId": { "type": "string" },
                      "row": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                      "column": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                      "rowHeader": { "type": ["string", "null"] },
                      "columnHeader": { "type": ["string", "null"] }
                    },
                    "required": ["blockId", "row", "column", "rowHeader", "columnHeader"],
                    "additionalProperties": false
                  },
                  { "type": "null" }
                ]
              },
              "status": { "type": "string", "enum": ["candidate", "accepted"] }
            },
            "required": [
              "id",
              "kind",
              "value",
              "number",
              "unit",
              "uncertainty",
              "condition",
              "metric",
              "dataset",
              "system",
              "sentenceKeys",
              "tableCell",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "kind": {
                "type": "string",
                "enum": ["task", "design", "sample", "dataset", "baseline", "method", "metric", "result"]
              },
              "value": { "type": "string" },
              "number": { "type": ["number", "null"] },
              "unit": { "type": ["string", "null"] },
              "uncertainty": { "type": ["string", "null"] },
              "condition": { "type": ["string", "null"] },
              "metric": { "type": ["string", "null"] },
              "dataset": { "type": ["string", "null"] },
              "system": { "type": ["string", "null"] },
              "sentenceKeys": { "type": "array", "items": { "type": "string" } },
              "tableCell": {
                "type": "object",
                "properties": {
                  "blockId": { "type": "string" },
                  "row": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "column": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "rowHeader": { "type": ["string", "null"] },
                  "columnHeader": { "type": ["string", "null"] }
                },
                "required": ["blockId", "row", "column", "rowHeader", "columnHeader"],
                "additionalProperties": false
              },
              "status": { "type": "string", "enum": ["candidate", "accepted"] }
            },
            "required": [
              "id",
              "kind",
              "value",
              "number",
              "unit",
              "uncertainty",
              "condition",
              "metric",
              "dataset",
              "system",
              "sentenceKeys",
              "tableCell",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["format", "schemaVersion", "paperId", "modelEtag", "generatedAt", "run", "facts"],
  "additionalProperties": false
}
