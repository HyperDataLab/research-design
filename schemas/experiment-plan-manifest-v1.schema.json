{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "experiment-plan-package"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "planVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "planId",
    "planVersion",
    "files"
  ],
  "additionalProperties": false
}
